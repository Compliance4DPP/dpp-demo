# Copy to .env (gitignored) and paste the signing key for did:web:validate.posedio.com#2026-v3.
# Paste the whole PEM between the quotes, line breaks included.
VC_KEY="-----BEGIN PRIVATE KEY-----
PASTE_KEY_HERE
-----END PRIVATE KEY-----"

# Optional: issuer (did:web:<host>, DID document at https://<host>/.well-known/did.json) and key id in that document.
# VC_DID_HOST=validate.posedio.com
# VC_KEY_ID=2026-v3
# VC_KEY_EXPIRES=2027-05-08T23:59:59Z   # "expires" of that key in did.json; credentials are not valid beyond it
