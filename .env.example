# The only env file of the project: copy to .env (gitignored, never commit it). docker-compose.yaml
# hands each service just the variables it reads, so a value here reaches only the services listed
# for it. Commented lines show defaults or examples.

# ===== Validation page (opa) =====
# Signing key for did:web:validate.posedio.com#2026-v3. Paste the whole PEM between the quotes,
# line breaks included. Without it, credentials are returned unsigned.
VC_KEY="-----BEGIN PRIVATE KEY-----
PASTE_KEY_HERE
-----END PRIVATE KEY-----"

# Issuer (did:web:<host>, DID document at https://<host>/.well-known/did.json; also used by web)
# and key id in that document.
# VC_DID_HOST=validate.posedio.com
# VC_KEY_ID=2026-v3
# VC_KEY_EXPIRES=2027-05-08T23:59:59Z   # "expires" of that key in did.json; credentials are not valid beyond it

# ===== Publishing stack (docker compose --profile publish, see publish/README.md) =====
# The publish service and the signer run locally; the Ecosystems Gateway is hosted.

# Hosted Ecosystems Gateway: base URL of its HTTP/JSON API (<base>CreateOffering etc.) and the
# bearer token for it (sent as "Authorization: Bearer <token>")
GATEWAY_URL=https://tec-ecosystemgateway.ptw.maschinenbau.tu-darmstadt.de/grpc/
GATEWAY_TOKEN=

# Provider of the offerings: its Gaia-X participant credential (a presentation with its
# gx:LegalPerson credential). The service offering points to it (gx:providedBy), the offering
# links it (providedBy), and it is combined with the signed service offering into one presentation.
PROVIDER_CREDENTIAL_URL=https://credentials.ptw.maschinenbau.tu-darmstadt.de/sd/participant.jwt
# DID the signer signs with and the credentials' issuer: the provider's DID (for PTW
# did:web:credentials.ptw.maschinenbau.tu-darmstadt.de, with its key as publish/signer/key.pem).
# Also passed to the signer as GXCOMPLIANCE_DID, overriding gxCompliance.DID of its config.
# ISSUER_DID=did:web:credentials.ptw.maschinenbau.tu-darmstadt.de
# Key id in that DID's did.json whose private key is publish/signer/key.pem (for PTW: X509-JWK2020,
# RSA, so signatureAlgorithm RS256 in the signer config). Passed to the signer as
# GXCOMPLIANCE_VERIFICATIONMETHOD = <ISSUER_DID>#<ISSUER_KEY_ID>.
# ISSUER_KEY_ID=X509-JWK2020
# Authorization header sent to the signer; must match a basicAuths entry of publish/signer/config.yaml
# SIGNER_AUTHORIZATION=Basic ZGVtbzp0ZXN0

# PUBLISH_TIMEOUT=10m   # the gateway waits up to 5 minutes for the ocean-node to index an offering
# MAX_REQUEST_BYTES=16777216

# Template values, read with {{env "TEMPLATE_..."}}; a new one also needs a line in docker-compose.yaml
# Terms and conditions of the offering: URL and SHA-256 of the document. Default: deltaDAO's
# Pontus-X portal terms (content/pages/terms.md of deltaDAO/mvg-portal, pinned to a commit)
# TEMPLATE_TERMS_URL=
# TEMPLATE_TERMS_SHA256=
# The one service offering presentation all offerings link (their serviceOfferingCredential):
# host the presentation a publish returns there, once (it is the same for every offering)
# TEMPLATE_SERVICE_OFFERING_URL=https://credentials.ptw.maschinenbau.tu-darmstadt.de/sd/dpp-service-offering.jwt
# File of the offering's download service; default: one shared sample DPP for every offering
# (upload samples/tool_dpp.json there)
# TEMPLATE_DPP_FILE_URL=https://credentials.ptw.maschinenbau.tu-darmstadt.de/static/tool_dpp.json
# Images of the description: where publish/templates/default/images/ (not in git) is uploaded
# TEMPLATE_IMAGE_BASE_URL=https://credentials.ptw.maschinenbau.tu-darmstadt.de/static/
# Gaia-X labelling criteria of the service offering; the template's example.org defaults are
# demo placeholders, replace them with the provider's real documents:
# contact (gx:providerContactInformation)
# TEMPLATE_CONTACT_URL=https://example.org/c4dpp/contact
# TEMPLATE_CONTACT_EMAIL=
# data protection measures (gx:legalDocuments, gx:DataProtectionRegulationMeasures)
# TEMPLATE_DATA_PROTECTION_URL=https://example.org/c4dpp/data-protection.pdf
# data portability: documentation and legal document, and the pricing page (gx:dataPortability)
# TEMPLATE_DATA_PORTABILITY_URL=https://example.org/c4dpp/data-portability.pdf
# TEMPLATE_PRICING_URL=https://example.org/c4dpp/pricing
# TEMPLATE_SERVICE_VERSION=1.0
# Author shown in the portal; default: the provider's name
# TEMPLATE_AUTHOR=
