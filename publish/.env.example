# Publish service settings (copy to publish/.env). Non-secret wiring (SIGNER_ADDR, GATEWAY_ADDR,
# DPP_DIR, TEMPLATE_DIR) is set in docker-compose.yaml.

# Authorization header sent to the signer, e.g. HTTP Basic of a user in its basicIdentityProvider
SIGNER_AUTHORIZATION=Basic ZGVtbzp0ZXN0
# SIGNER_TLS=false
# GATEWAY_TLS=false

# DID the signer signs with (gxCompliance.DID of its config); the credentials' issuer
ISSUER_DID=did:web:example.org

# Values for the templates, read with {{env "TEMPLATE_..."}}
TEMPLATE_AUTHOR=DPP demo
TEMPLATE_PROVIDED_BY=https://example.org/.well-known/gx_legalperson.jwt
TEMPLATE_TERMS_URL=https://example.org/terms.pdf
TEMPLATE_TERMS_SHA256=

# PUBLISH_TIMEOUT=10m   # the gateway waits up to 5 minutes for the ocean-node to index an offering
# MAX_MESSAGE_BYTES=16777216
