# Ecosystems Gateway settings (copy to publish/gateway.env). All options, including the S3
# DDO store: https://github.com/PTW-TUD/Ecosystems-Gateway/blob/nautilus_v2/.env.example
NETWORK=OPSEPOLIA
# Needs OP Sepolia ETH for gas
PRIVATE_KEY=0x...
# Where the gateway stores the node-encrypted DDO: ipfs or s3
DDO_STORE=ipfs
IPFS_UPLOAD_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
PROVIDED_BY=https://example.org/.well-known/gx_legalperson.jwt
NESTJS_LOG_LEVELS=log,warn
