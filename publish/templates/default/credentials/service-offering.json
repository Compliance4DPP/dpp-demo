{
  "@context": [
    "https://www.w3.org/ns/credentials/v2",
    "https://w3id.org/gaia-x/development#"
  ],
  "type": ["VerifiableCredential", "gx:ServiceOffering"],
  "id": {{json uuid}},
  "issuer": {{json .Issuer}},
  "validFrom": {{json .Now}},
  "credentialSubject": {
    "id": {{json (printf "%s#cs" .ID)}},
    "type": "gx:ServiceOffering",
    "gx:name": {{json (printf "DPP %s" (prop .DPP "ManufacturerProductDesignation" | default .ID))}},
    "gx:description": "Download of a Digital Product Passport (AAS JSON)",
    "gx:keyword": ["DPP", "AAS"],
    "gx:providedBy": {"id": {{json (env "TEMPLATE_PROVIDED_BY")}}},
    "gx:serviceOfferingTermsAndConditions": [
      {"gx:url": {{json (env "TEMPLATE_TERMS_URL")}}, "gx:hash": {{json (env "TEMPLATE_TERMS_SHA256")}}}
    ],
    "gx:dataAccountExport": [
      {"gx:requestType": "API", "gx:accessType": "digital", "gx:formatType": "application/json"}
    ],
    "gx:servicePolicy": "default:allow",
    "gx:dataProtectionRegime": ["GDPR2016"]
  }
}
