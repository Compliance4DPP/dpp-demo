{{- /*
  Gaia-X service offering (gx:DigitalServiceOffering, ontology https://w3id.org/gaia-x/development#,
  checked against its SHACL shapes): the DPP download service, provided by the participant of
  PROVIDER_CREDENTIAL_URL. It is the same for every offering (no DPP-specific values), so one
  presentation of it, hosted once at TEMPLATE_SERVICE_OFFERING_URL, serves all offerings: the
  publish service combines it with the participant's credentials into that presentation, and the
  offerings link it as their serviceOfferingCredential. Its id is that URL without ".jwt".
  It covers the Gaia-X labelling criteria for digital service offerings (version, contact,
  data protection measures, data portability). The example.org defaults are demo placeholders:
  set the TEMPLATE_* variables to the provider's real documents.
*/ -}}
{{- $url := env "TEMPLATE_SERVICE_OFFERING_URL" | default "https://credentials.ptw.maschinenbau.tu-darmstadt.de/sd/dpp-service-offering.jwt" -}}
{{- $id := trimSuffix ".jwt" $url -}}
{{- /* terms and conditions: by default deltaDAO's Pontus-X portal terms, pinned to a commit so
       that the URL and its SHA-256 stay valid together; own terms need both variables */ -}}
{{- $terms := env "TEMPLATE_TERMS_URL" -}}
{{- $termsHash := env "TEMPLATE_TERMS_SHA256" -}}
{{- if not $terms}}
  {{- $terms = "https://raw.githubusercontent.com/deltaDAO/mvg-portal/646d9c55ac00e9390add0aaab2516dd5e231797a/content/pages/terms.md"}}
  {{- $termsHash = "eaedd43e132657b195b51c90afc5d47ebe236feedaf641354c9aa6b2d2890550"}}
{{- end}}
{{- $termsHash = required "TEMPLATE_TERMS_SHA256 (with TEMPLATE_TERMS_URL)" $termsHash -}}
{{- $contact := env "TEMPLATE_CONTACT_URL" | default "https://example.org/c4dpp/contact" -}}
{{- $dataProtection := env "TEMPLATE_DATA_PROTECTION_URL" | default "https://example.org/c4dpp/data-protection.pdf" -}}
{{- $portability := env "TEMPLATE_DATA_PORTABILITY_URL" | default "https://example.org/c4dpp/data-portability.pdf" -}}
{{- $pricing := env "TEMPLATE_PRICING_URL" | default "https://example.org/c4dpp/pricing" -}}
{
  "@context": [
    "https://www.w3.org/ns/credentials/v2",
    "https://w3id.org/gaia-x/development#"
  ],
  "type": ["VerifiableCredential", "gx:DigitalServiceOffering"],
  "id": {{json $id}},
  "issuer": {{json .Issuer}},
  "validFrom": {{json .Now}},
  "credentialSubject": {
    "id": {{json (printf "%s#cs" $id)}},
    "type": "gx:DigitalServiceOffering",
    "name": "COMPLIANCE4DPP Digital Product Passport download",
    "description": "Download of a Digital Product Passport (AAS JSON, IDTA 02099-1)",
    "gx:keyword": ["DPP", "AAS", "IDTA 02099-1", "COMPLIANCE4DPP"],
    "gx:providedBy": {"id": {{json .Provider.ID}}},
    "gx:serviceOfferingTermsAndConditions": [
      {"type": "gx:TermsAndConditions", "gx:url": {"@id": {{json $terms}}}, "gx:hash": {{json $termsHash}}}
    ],
    "gx:usageTermsAndConditions": [
      {"type": "gx:UsageTermsAndConditions", "gx:url": {"@id": {{json $terms}}}, "gx:hash": {{json $termsHash}}}
    ],
    "gx:servicePolicy": [
      {
        "type": "gx:AccessUsagePolicy",
        "gx:policyLanguage": "ODRL",
        "gx:policyDocument": "{\"@context\": \"http://www.w3.org/ns/odrl.jsonld\", \"@type\": \"Offer\", \"permission\": [{\"action\": \"use\"}]}"
      }
    ],
    "gx:dataAccountExport": [
      {"type": "gx:DataAccountExport", "gx:requestType": "API", "gx:accessType": "digital", "gx:formatType": "application/json"}
    ],
    "gx:dataProtectionRegime": ["GDPR2016"],
    "gx:dataPortability": [
      {
        "type": "gx:DataPortability",
        "gx:resource": "Digital Product Passport (AAS JSON)",
        "gx:means": ["Download through Pontus-X"],
        "gx:formats": ["application/json"],
        "gx:documentations": [{"@id": {{json $portability}}}],
        "gx:legalDocument": {"type": "gx:LegalDocument", "gx:url": {"@id": {{json $portability}}}},
        "gx:pricing": {"@id": {{json $pricing}}},
        "gx:deletionMethods": ["Deletion of the offering's files on request"],
        "gx:deletionTimeframe": "30 days"
      }
    ],
    "gx:legalDocuments": [
      {"type": "gx:DataProtectionRegulationMeasures", "gx:url": {"@id": {{json $dataProtection}}}}
    ],
    "gx:providerContactInformation": {
      "type": "gx:ContactInformation",
      "gx:url": {"@id": {{json $contact}}}
      {{- with env "TEMPLATE_CONTACT_EMAIL"}},
      "gx:email": {{json .}}
      {{- end}}
    },
    "gx:version": {{json (env "TEMPLATE_SERVICE_VERSION" | default "1.0")}},
    "gx:provisionType": "public",
    "gx:serviceScope": "Download of one Digital Product Passport as AAS JSON through Pontus-X"
  }
}
