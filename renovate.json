{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OPA image pinned in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["(?<depName>openpolicyagent/opa):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Prettier pinned in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["(?<depName>prettier)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Go image pinned in the Makefile (publish service tests and gofmt)",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["(?<depName>golang):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "A major OPA bump in the Makefile (tests) and compose (demo) must move together",
      "matchDepNames": ["openpolicyagent/opa"],
      "matchUpdateTypes": ["major"],
      "groupName": "OPA"
    },
    {
      "description": "A major Go bump in the Makefile (tests, gofmt) and publish/Dockerfile (image) must move together",
      "matchDepNames": ["golang"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go"
    }
  ]
}
